{
  "name": "bypasser",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint ./packages/**/src --fix",
    "knip": "knip",
    "build:shared": "pnpm --filter @caido-community/bypasser build",
    "build": "pnpm build:shared && caido-dev build",
    "watch": "pnpm build:shared && caido-dev watch"
  },
  "devDependencies": {
    "@caido-community/dev": "0.1.7",
    "@caido/eslint-config": "0.10.0",
    "@caido/tailwindcss": "0.0.1",
    "@vitejs/plugin-vue": "5.2.1",
    "eslint": "9.29.0",
    "postcss-prefixwrap": "1.51.0",
    "tailwindcss": "3.4.13",
    "tailwindcss-primeui": "0.3.4",
    "typescript": "5.5.4",
    "knip": "5.70.2"
  }
}
